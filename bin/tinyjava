#!/bin/bash
# TinyJava CLI launcher
# Resolves TINYJAVA_HOME from this script's location and runs the fat JAR.
set -euo pipefail
TINYJAVA_HOME="$(cd "$(dirname "$0")/.." && pwd)"
JAR="$TINYJAVA_HOME/teavm-backend/llvm/target/teavm-ir-dumper-0.1.0-SNAPSHOT.jar"
if [[ ! -f "$JAR" ]]; then
    echo "tinyjava: JAR not found at $JAR" >&2
    echo "Run: cd '$TINYJAVA_HOME/teavm-backend/llvm' && mvn package -q" >&2
    exit 1
fi
exec java -jar "$JAR" "$@"
