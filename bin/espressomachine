#!/bin/bash
# EspressoMachine CLI launcher
# Resolves ESPRESSOMACHINE_HOME from this script's location and runs the fat JAR.
set -euo pipefail
ESPRESSOMACHINE_HOME="$(cd "$(dirname "$0")/.." && pwd)"
shopt -s nullglob
for f in "$ESPRESSOMACHINE_HOME/teavm-backend/llvm/target/"*.jar; do JAR="$f"; break; done
shopt -u nullglob
if [[ -z "${JAR:-}" || ! -f "$JAR" ]]; then
    echo "espressomachine: JAR not found at $ESPRESSOMACHINE_HOME/teavm-backend/llvm/target/" >&2
    echo "Run: cd '$ESPRESSOMACHINE_HOME/teavm-backend/llvm' && mvn package -q" >&2
    exit 1
fi
exec java -jar "$JAR" "$@"
