#!/bin/bash
# EspressoMachine CLI launcher
# Resolves TINYJAVA_HOME from this script's location and runs the fat JAR.
set -euo pipefail
TINYJAVA_HOME="$(cd "$(dirname "$0")/.." && pwd)"
shopt -s nullglob
for f in "$TINYJAVA_HOME/teavm-backend/llvm/target/"*.jar; do JAR="$f"; break; done
shopt -u nullglob
if [[ -z "${JAR:-}" || ! -f "$JAR" ]]; then
    echo "espressomachine: JAR not found at $TINYJAVA_HOME/teavm-backend/llvm/target/" >&2
    echo "Run: cd '$TINYJAVA_HOME/teavm-backend/llvm' && mvn package -q" >&2
    exit 1
fi
exec java -jar "$JAR" "$@"
